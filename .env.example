# Copy this file to .env and fill in your values
TELEGRAM_BOT_TOKEN=paste-your-token-from-botfather
ALLOWED_USER_ID=

# Optional settings
TIMEZONE=Australia/Hobart
# Daily nudge time (24-hour HH:MM), or off
NUDGE_TIME=08:00
# Longest video accepted, in minutes (for YouTube links)
MAX_MINUTES=10
# Weekly "remember this?" message from an older note (on/off)
RESURFACE=on
NOTES_DIR=notes
WHISPER_MODEL=small
OLLAMA_MODEL=qwen3:8b
HF_HUB_DISABLE_SYMLINKS_WARNING=1
FRAME_EVERY_SECONDS=2
# Only if Instagram/Facebook links fail with a login error:
# COOKIES_FILE=D:\Python projects\reel-notes\cookies.txt
# Optional, for higher GitHub API limits (repo lookups work without it):
# GITHUB_TOKEN=
# Windows only, if tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Update yt-dlp every night at this time (HH:MM), or "off". Instagram/Facebook
# changes often break old versions.
YTDLP_UPDATE_TIME=03:30
